   <property name="styleSheet">
    <string notr="true">QPushButton {
    background-color: #4ECDC4;
    color: white;
    border: 2px solid #ffffff;
    border-radius: 5px;
    font-size: 48px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #96CEB4;
}

QPushButton:pressed {
    background-color: #0d2a60;
}

QPushButton:disabled {
    background-color: rgba(18, 60, 136, 100);
    color: rgba(255, 255, 255, 80);
}

QPushButton[used=&quot;true&quot;] {
    background-color: rgba(18, 60, 136, 100);
    color: rgba(255, 255, 255, 80);
}

QLabel {
    background-color: #45B7D1;
    color: white;
    border: 2px solid #ffffff;
    border-radius: 5px;
    font-size: 24px;
    font-weight: bold;
}

QWidget#centralwidget {
    background-color: #0f0639;
}</string>
